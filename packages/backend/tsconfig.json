{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",

    "rootDir": "./src",
    "outDir": "./dist",

    "removeComments": true,
    "strictPropertyInitialization": true,
    "alwaysStrict": true,
    "noImplicitReturns": true,

    "paths": {
      "@/*": ["./src/*"]
    },

    "sourceMap": true,
    "declaration": false,
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": ["./src/**/*", "./src/types/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
