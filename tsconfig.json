{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "paths": {
      "@/*": ["./apps/backend/src/*"]
    },
    "types": ["node"],
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "jsx": "preserve"
  },
  "include": [
    "tests/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "apps/backend/src/types/**/*.d.ts"
  ]
}
